// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  id          String   @id @default(uuid()) @db.VarChar(36)
  nome        String   @db.VarChar(100)
  email       String   @unique @db.VarChar(150)
  senha_hash  String   @db.VarChar(255)
  perfil      String   @db.VarChar(20) // 'COMUM' | 'TECNICO'
  criado_em   DateTime @default(now())

  chamados_abertos Chamado[]       @relation("SolicitanteChamados")
  interacoes       Interacao[]
  logs_auditoria   LogsAuditoria[]

  @@map("usuarios")
}

model Chamado {
  id              String   @id @default(uuid()) @db.VarChar(36)
  id_solicitante  String   @db.VarChar(36)
  titulo          String   @db.VarChar(150)
  descricao       String   @db.Text
  categoria       String   @db.VarChar(50)  // Preenchimento da IA: Hardware | Software | Rede | Seguranca
  prioridade      String   @db.VarChar(20)  // Preenchimento da IA: Baixa | Media | Alta | Critica
  risco_seguranca Boolean  @default(false)  // Sinalizador de ameaÃ§a da IA
  status          String   @db.VarChar(50)  // NOVO | EM_ATENDIMENTO | AGUARDANDO_USUARIO | ESCALONADO | RESOLVIDO
  criado_em       DateTime @default(now())
  atualizado_em   DateTime @updatedAt

  solicitante    Usuario         @relation("SolicitanteChamados", fields: [id_solicitante], references: [id])
  interacoes     Interacao[]
  logs_auditoria LogsAuditoria[]

  @@map("chamados")
}

model Interacao {
  id         String   @id @default(uuid()) @db.VarChar(36)
  id_chamado String   @db.VarChar(36)
  id_autor   String   @db.VarChar(36)
  mensagem   String   @db.Text
  criado_em  DateTime @default(now())

  chamado Chamado @relation(fields: [id_chamado], references: [id])
  autor   Usuario @relation(fields: [id_autor], references: [id])

  @@map("interacoes")
}

model LogsAuditoria {
  id          String   @id @default(uuid()) @db.VarChar(36)
  id_chamado  String   @db.VarChar(36)
  id_usuario  String   @db.VarChar(36)
  acao        String   @db.VarChar(100) // Ex: "MudanÃ§a de Status"
  detalhes    Json     // Ex: { "de": "NOVO", "para": "EM_ATENDIMENTO" }
  criado_em   DateTime @default(now())

  chamado Chamado @relation(fields: [id_chamado], references: [id])
  usuario Usuario @relation(fields: [id_usuario], references: [id])

  @@map("logs_auditoria")
}


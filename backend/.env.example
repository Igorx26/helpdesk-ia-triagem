# Copie este arquivo como .env e preencha os valores reais
# cp .env.example .env

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@localhost:5432/helpdesk_db?schema=public"

# JWT — gere um secret forte (ex: openssl rand -hex 32)
JWT_SECRET=troque_por_um_secret_forte_em_producao

# Google Gemini — obtenha em https://aistudio.google.com
GEMINI_API_KEY=sua_chave_gemini_aqui

# Servidor
PORT=3001
NODE_ENV=development

